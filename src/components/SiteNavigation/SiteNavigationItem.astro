---
interface Props {
    link: string;
    label: string;
}

const { link, label } = Astro.props;

const normalize = (path: string) => path.replace(/\/$/, "") || "/";
const isExactMatch = normalize(Astro.url.pathname) === normalize(link);
const isAncestorMatch =
    normalize(link) !== "/" &&
    normalize(Astro.url.pathname).startsWith(normalize(link));

const ariaCurrent = isExactMatch
    ? "page"
    : isAncestorMatch
      ? "true"
      : undefined;
---

<a class="nav-link" href={link} aria-current={ariaCurrent}>{label}</a>

<style>
    .nav-link {
        color: var(--color-light);
        font-size: var(--size-1);
        font-weight: 600;
        text-transform: uppercase;
        text-decoration: none;
        text-shadow: 1px 1px 2px var(--color-dark);
        position: relative;
        transition: color 0.15s ease-in-out;
        padding-block: 4px;

        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--color-primary);
            transition: background 0.15s ease-in-out;
        }

        &:visited {
            color: var(--color-light);
        }

        &:hover {
            color: var(--color-secondary);

            &::after {
                background: var(--color-pop);
            }
        }

        &:focus-visible {
            outline: 2px solid var(--color-secondary);
            outline-offset: var(--space-3xs);
        }
    }

    .nav-link[aria-current]::after {
        background: var(--color-pop);
    }
</style>
