---
import { getCollection } from "astro:content";
import nav from "@data/nav.json";

const allPages = await getCollection("pages");
const navPages = nav.nav
    .map((slug) => allPages.find((page) => page.id === slug))
    .filter((page): page is NonNullable<typeof page> => Boolean(page));
---

<section class="visitor-guide">
    <header class="header prose">
        <h2 class="title">Visitor's Guide</h2>
        <p>
            This site is my digital home. A place that I control with no ads, no
            tracking, no algorithms, and no trend chasing. Like a pair of cargo
            shorts, I offer a 100% <em>"I am not trendy"</em> guarantee.
        </p>
    </header>
    <div class="destinations auto-grid">
        {
            navPages.map((page) => (
                <article class="destination">
                    <h3 class="destination-title">
                        <a class="destination-link" href={`/${page.id}`}>
                            {page.data.title}
                        </a>
                    </h3>
                    <p>{page.data.description}</p>
                </article>
            ))
        }
    </div>
</section>

<style>
    .visitor-guide {
        padding-block: var(--space-xl);
    }

    .title {
        text-align: center;
    }

    .destinations {
        padding-block: var(--space-s);
    }

    .destination {
        padding: var(--space-xs);
        border: 2px solid var(--color-dark);
    }

    .destination-title {
        font-size: var(--size-2);
    }

    .destination-link {
        /*transition: color 0.2s ease-in;*/

        &:hover {
            /*color: var(--color-primary-shade);*/
        }
    }
</style>
