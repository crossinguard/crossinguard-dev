---
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import PostsGrid from "@components/PostsGrid/PostsGrid.astro";
import BreadcrumbNav from "@components/BreadcrumbNav/BreadcrumbNav.astro";
import pagination from "@data/pagination.json";

const allPosts = await getCollection("posts", ({ data }) => {
    return import.meta.env.PROD ? data.isDraft !== true : true;
});

const sortedPosts = allPosts.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const firstPagePosts = sortedPosts.slice(0, pagination.postsPerPage);
const lastPage = Math.ceil(sortedPosts.length / pagination.postsPerPage);
---

<PageLayout pageID="posts">
    <BreadcrumbNav
        slot="before-content"
        segments={[{ label: "Posts", href: "/posts" }, { label: "Page 1" }]}
    />

    <PostsGrid
        posts={firstPagePosts}
        currentPage={1}
        lastPage={lastPage}
        nextUrl={lastPage > 1 ? "/posts/page/2" : undefined}
    />
</PageLayout>
