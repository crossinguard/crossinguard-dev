---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import PostsGrid from "@components/PostsGrid/PostsGrid.astro";
import BreadcrumbNav from "@components/BreadcrumbNav/BreadcrumbNav.astro";
import pagination from "@data/pagination.json";

export const getStaticPaths = (async ({ paginate }) => {
    const allPosts = await getCollection("posts", ({ data }) => {
        return import.meta.env.PROD ? data.isDraft !== true : true;
    });

    const sortedPosts = allPosts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );

    return paginate(sortedPosts, { pageSize: pagination.postsPerPage });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;

const prevUrl = page.currentPage === 2 ? "/posts" : page.url.prev;
---

<PageLayout pageID="posts">
    <BreadcrumbNav
        segments={[
            { label: "Posts", href: "/posts" },
            { label: `Page ${page.currentPage}` },
        ]}
    />
    <PostsGrid
        posts={page.data}
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        prevUrl={prevUrl}
        nextUrl={page.url.next}
    />
</PageLayout>
